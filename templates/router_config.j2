{# ---------------------------------------------------------------
   router_config.j2 - standard Cisco IOS baseline configuration.
   Rendered once per device from inventory/devices.yml.
   --------------------------------------------------------------- #}
!
! Generated by netkit - do not edit by hand.
! Device : {{ hostname }} (role: {{ role }})
! Router ID: {{ router_id }}   OSPF process: {{ ospf_process }}   BGP AS: {{ bgp_as }}
!
hostname {{ hostname }}
!
ip domain-name {{ domain }}
!
username {{ username }} privilege 15 secret {{ secret }}
enable secret {{ secret }}
!
logging buffered 16384 informational
service timestamps log datetime msec
no ip http server
!
{% for intf in interfaces %}
interface {{ intf.name }}
 description {{ intf.description }}
 ip address {{ intf.ip }} {{ intf.mask }}
 no shutdown
!
{% endfor %}
!
router ospf {{ ospf_process }}
 router-id {{ router_id }}
 log-adjacency-changes
{% for intf in interfaces if intf.ospf_network is defined %}
 network {{ intf.ospf_network }} {{ intf.ospf_wildcard }} area {{ intf.ospf_area }}
{% endfor %}
!
{% if bgp_neighbors %}
router bgp {{ bgp_as }}
 bgp router-id {{ router_id }}
 bgp log-neighbor-changes
{% for n in bgp_neighbors %}
 neighbor {{ n.ip }} remote-as {{ n.remote_as }}
 neighbor {{ n.ip }} description {{ n.description }}
{% endfor %}
!
{% endif %}
line vty 0 4
 login local
 transport input ssh
line console 0
 logging synchronous
!
end
